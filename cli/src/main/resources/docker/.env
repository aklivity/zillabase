############
# General
############
VOLUME_LABEL=io.aklivity.zillabase.cli.project
PROJECT_NAME=zillabase
ZILLA_VERSION=0.9.128
ZILLABASE_VERSION=develop-SNAPSHOT

############
# Admin
############
ADMIN_PORT=7184
ADMIN_PGSQL_PORT=4567
ADMIN_HTTP_URL=http://admin.zillabase.dev:8085

############
# Zilla API Gateway
############
ZILLA_HTTP_PORT=8080

############
# Studio
############
STUDIO_PORT=7194

############
# Config
############
CONFIG_SERVER_HOST=config.zillabase.dev
CONFIG_SERVER_PORT=7184

############
# Kafka
############
KAFKA_VERSION=3.2.3
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVER=kafka.zillabase.dev:29092
ALLOW_PLAINTEXT_LISTENER=yes
KAFKA_CFG_NODE_ID=1
KAFKA_CFG_BROKER_ID=1
KAFKA_CFG_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=1@127.0.0.1:9093
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CLIENT:PLAINTEXT,INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CFG_LOG_DIRS=/bitnami/kafka/logs
KAFKA_CFG_PROCESS_ROLES=broker,controller
KAFKA_CFG_LISTENERS=CLIENT://:9092,INTERNAL://:29092,CONTROLLER://:9093
KAFKA_CFG_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_CFG_ADVERTISED_LISTENERS=CLIENT://localhost:9092,INTERNAL://kafka.zillabase.dev:29092
KAFKA_CFG_AUTO_CREATE_TOPICS_ENABLE=true

############
# Apicurio
############
APICURIO_VERSION=3.0.4
QUARKUS_HTTP_CORS_ORIGINS=*
APICURIO_STORAGE_KIND=kafkasql
APICURIO_HOST=apicurio.zillabase.dev
APICURIO_PORT=8080
APICURIO_KAFKASQL_BOOTSTRAP_SERVERS=kafka.zillabase.dev:29092
APICURIO_GROUP_ID=default

############
# Karapace
############
KARAPACE_VERSION=3.7.1
KARAPACE_ADVERTISED_HOSTNAME=karapace.zillabase.dev
KARAPACE_BOOTSTRAP_URI=kafka.zillabase.dev:29092
KARAPACE_PORT=8081
KARAPACE_HOST=0.0.0.0
KARAPACE_CLIENT_ID=karapace
KARAPACE_GROUP_ID=karapace-registry
KARAPACE_MASTER_ELIGIBILITY=true
KARAPACE_TOPIC_NAME=_schemas
KARAPACE_LOG_LEVEL=WARNING
KARAPACE_COMPATIBILITY=FULL

############
# PostgreSQL
############
POSTGRES_VERSION=15-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metadata
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C
POSTGRES_HOST_AUTH_METHOD=trust

############
# Minio
############
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z
MINIO_ROOT_USER=hummockadmin
MINIO_ROOT_PASSWORD=hummockadmin

############
# Risingwave
############\
RISINGWAVE_VERSION=v2.0.2
RISINGWAVE_HOST=risingwave.zillabase.dev
RISINGWAVE_PORT=4566
RW_STANDALONE_META_OPTS=--listen-addr 0.0.0.0:5690 --advertise-addr 0.0.0.0:5690 --dashboard-host 0.0.0.0:5691 --backend sql --sql-endpoint postgres://postgres:@postgres.zillabase.dev:5432/metadata --state-store hummock+minio://hummockadmin:hummockadmin@minio.zillabase.dev:9301/hummock001 --data-directory hummock_001
RW_STANDALONE_COMPUTE_OPTS=--listen-addr 0.0.0.0:5688 --advertise-addr 0.0.0.0:5688 --meta-address http://0.0.0.0:5690
RW_STANDALONE_FRONTEND_OPTS=--listen-addr 0.0.0.0:4566 --advertise-addr 0.0.0.0:4566 --health-check-listener-addr 0.0.0.0:6786 --meta-addr http://0.0.0.0:5690
RW_STANDALONE_COMPACTOR_OPTS=--listen-addr 0.0.0.0:6660 --advertise-addr 0.0.0.0:6660 --meta-address http://0.0.0.0:5690

############
# Keycloak
############
KEYCLOAK_VERSION=26
KEYCLOAK_URL=http://keycloak.zillabase.dev:8180
KEYCLOAK_PORT=8180
KEYCLOAK_DATABASE_VENDOR=dev-file
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=3600
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_IMPLICIT=3600
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

############
# Api-gen
############
KARAPACE_URL=http://karapace.zillabase.dev:8081
APICURIO_REGISTRY_URL=http://apicurio.zillabase.dev:8080
KEYLOAK_JWT_SECRET=secret

############
# Auth
############
AUTH_HOST=auth.zillabase.dev
AUTH_PORT=7185
KEYCLOAK_REALM=zillabase

############
# Python UDF
############
PYTHON_UDF_SERVER_HOST=udf-server-python.zillabase.dev
PYTHON_UDF_SERVER_PORT=8816
PYTHON_UDF_SERVER_URL=http://udf-server-python.zillabase.dev:5000

############
# Java UDF
############
JAVA_UDF_SERVER_HOST=udf-server-java.zillabase.dev
JAVA_UDF_SERVER_PORT=8815
JAVA_UDF_SERVER_URL=http://udf-server-java.zillabase.dev:5001

